# Configuración del panel de Sanity.
# Copia este archivo como "studio/.env" (sin ".example") y rellénalo.
# El archivo ".env" no se sube a GitHub.

# ID de tu proyecto de Sanity (https://www.sanity.io/manage, dentro de tu proyecto).
SANITY_STUDIO_PROJECT_ID=

# Normalmente "production".
SANITY_STUDIO_DATASET=production

# Nombre de tu panel: se publicará en https://<nombre>.sanity.studio
# Solo letras minúsculas, números y guiones. Si lo dejas vacío, Sanity te lo pregunta al publicar.
SANITY_STUDIO_HOST=
