---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import LatestPosts from '../components/LatestPosts.astro';
import FAQ from '../components/FAQ.astro';
import Secciones from '../components/Secciones.astro';
import UltimosProductos from '../components/UltimosProductos.astro';
import Newsletter from '../components/Newsletter.astro';
import Contact from '../components/Contact.astro';
import DatosEstructurados from '../components/DatosEstructurados.astro';
---
<BaseLayout>
  <DatosEstructurados slot="head" />
  <Hero />
  <Services />
  <Secciones lugar="despues-servicios" />
  <UltimosProductos />
  <About />
  <Secciones lugar="despues-sobre" />
  <LatestPosts />
  <FAQ />
  <Secciones lugar="antes-contacto" />
  <Newsletter />
  <Contact />
</BaseLayout>
