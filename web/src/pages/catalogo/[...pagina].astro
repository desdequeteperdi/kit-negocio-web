---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import { getContenido, catalogoVisible, productosPublicos } from '../../lib/contenido';
export async function getStaticPaths() {
  const c = await getContenido();
  // Solo se genera /xxx/ si la función está activada: así no queda una página de redirección en el sitemap
  return catalogoVisible(c) ? [{ params: { pagina: undefined } }] : [];
}
const c = await getContenido();
const productos = productosPublicos(c);
const categorias = c.catalogo.categorias.filter((k) => productos.some((p) => p.categoria === k.slug));
---
<BaseLayout titulo={`${c.catalogo.titulo} | ${c.negocio.nombre}`} descripcion={c.catalogo.introduccion}>
  <section>
    <div class="contenedor">
      <h1>{c.catalogo.titulo}</h1>
      <p>{c.catalogo.introduccion}</p>
      <p class="etiquetas">{categorias.map((k) => <a href={`/catalogo/${k.slug}`}>{k.nombre}</a>)}</p>
      {categorias.map((k) => (
        <div class="grupo-catalogo">
          <h2><a href={`/catalogo/${k.slug}`}>{k.nombre}</a></h2>
          <div class="entradas">{productos.filter((p) => p.categoria === k.slug).map((p) => <TarjetaProducto producto={p} />)}</div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
