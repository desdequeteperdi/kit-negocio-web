---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContenido, hayVenta } from '../lib/contenido';
const contenido = await getContenido();
const { legal, negocio, buscadores, newsletter, consultaWhatsapp, reservas, blog } = contenido;
const venta = hayVenta(contenido);
const seguimiento = Boolean(buscadores.ga4 || buscadores.gtm || buscadores.metaPixel);
const herramientasCookies = [
  buscadores.ga4 && 'Google Analytics (medición de visitas)',
  buscadores.gtm && 'Google Tag Manager (gestión de etiquetas de medición)',
  buscadores.metaPixel && 'el píxel y la medición de conversiones de Meta (medición de anuncios)',
].filter((x): x is string => Boolean(x));
const textoCookies = herramientasCookies.length > 1
  ? `${herramientasCookies.slice(0, -1).join(', ')} y ${herramientasCookies[herramientasCookies.length - 1]}`
  : herramientasCookies[0] ?? '';
const hayComentarios = Boolean(blog.mostrar && (blog.comentarios || blog.entradas.some((e) => e.comentarios === 'activados')) && blog.cusdisId);
---
<BaseLayout titulo={`Política de privacidad | ${negocio.nombre}`}>
  <div class="texto-legal">
    <h1>Política de privacidad</h1>
    <!-- Borrador de partida: identifica necesidades, no certifica cumplimiento. Revisar antes de recoger datos reales. Si se añade analítica o cookies no técnicas, hace falta información y consentimiento. -->
    <p><strong>Responsable:</strong> {legal.titular} · {legal.nif} · {legal.domicilio} · {negocio.email}</p>
    <p><strong>Datos que recogemos:</strong> los del formulario de contacto (nombre, email, teléfono opcional y mensaje).</p>
    <p><strong>Para qué:</strong> responder a tu consulta.</p>
    <p><strong>Base jurídica:</strong> tu consentimiento al enviar el formulario.</p>
    <p><strong>Conservación:</strong> {legal.plazoConservacion}.</p>
    {newsletter.mostrar && <p><strong>Newsletter:</strong> si te suscribes, guardamos tu email para enviarte comunicaciones por correo, con tu consentimiento. Puedes darte de baja en cualquier momento desde el enlace de cada correo. Los datos se almacenan en Brevo, que actúa como encargado del tratamiento.</p>}
    {consultaWhatsapp.mostrar && negocio.whatsapp && <p><strong>Consulta por WhatsApp:</strong> si usas el formulario de WhatsApp, guardamos tu nombre, teléfono y mensaje en una hoja de cálculo de Google para atender tu consulta, y se abre WhatsApp con el mensaje preparado. Google actúa como encargado del tratamiento y WhatsApp tiene su propia política de privacidad.</p>}
    {reservas.mostrar && <p><strong>Reservas:</strong> si reservas, guardamos tu nombre, teléfono, email, notas y la fecha elegida en nuestro calendario y en una hoja de cálculo de Google para gestionar tu reserva. Google actúa como encargado del tratamiento.</p>}
    {hayComentarios && <p><strong>Comentarios del blog:</strong> si envías un comentario en una entrada, se recogen el nombre o alias, el texto del comentario y, opcionalmente, tu email para moderarlo y mostrarlo públicamente tras su revisión, mediante el servicio Cusdis.</p>}
    {venta && <p><strong>Compras:</strong> si compras, el pago lo gestiona Stripe en su propia página y nosotros no vemos los datos de tu tarjeta. Recibimos los datos necesarios para entregarte el pedido (nombre, email{legal.tipoVenta !== 'digital' && ', dirección de envío'}) y los conservamos el tiempo que exijan las obligaciones fiscales y contables. Stripe actúa como responsable o encargado según el caso y puede tratar datos fuera del Espacio Económico Europeo.</p>}
    <p><strong>Destinatarios:</strong> el servicio de alojamiento y formularios (Netlify) actúa como encargado del tratamiento.</p>
    {seguimiento && <p><strong>Cookies:</strong> con tu consentimiento, usamos {textoCookies}. No se activan hasta que pulsas «Aceptar» y puedes cambiar tu decisión en el enlace «Cookies» del pie de página. Estos proveedores pueden tratar datos fuera del Espacio Económico Europeo.</p>}
    <p><strong>Tus derechos:</strong> acceso, rectificación, supresión, oposición, limitación y portabilidad, escribiendo a {negocio.email}. Puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).</p>
    <p><a href="/">Volver al inicio</a></p>
  </div>
</BaseLayout>
