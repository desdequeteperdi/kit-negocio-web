---
// Datos estructurados (JSON-LD) de un producto: Product (con oferta solo si hay precio) y BreadcrumbList.
import { getContenido, type Producto } from '../lib/contenido';
interface Props { producto: Producto }
const { producto: p } = Astro.props;
const c = await getContenido();
const k = c.catalogo.categorias.find((x) => x.slug === p.categoria);
const abs = (ruta: string) => new URL(ruta, Astro.site).href;
const url = abs(`/catalogo/${p.categoria}/${p.slug}`);
const grafo: Record<string, unknown>[] = [
  {
    '@type': 'Product',
    name: p.nombre,
    ...(p.resumen && { description: p.resumen }),
    ...(p.imagen && !/\.svg(\?|$)/i.test(p.imagen) && { image: abs(p.imagen) }),
    ...(k && { category: k.nombre }),
    url,
    ...(p.precio !== null && {
      offers: {
        '@type': 'Offer',
        price: p.precio,
        priceCurrency: 'EUR',
        availability: p.disponible ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
        url,
      },
    }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: c.catalogo.titulo, item: abs('/catalogo') },
      ...(k ? [{ '@type': 'ListItem', position: 3, name: k.nombre, item: abs(`/catalogo/${k.slug}`) }] : []),
      { '@type': 'ListItem', position: k ? 4 : 3, name: p.nombre, item: url },
    ],
  },
];
// "<" escapado para que ningún texto del panel pueda cerrar la etiqueta script
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo }).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json}></script>
