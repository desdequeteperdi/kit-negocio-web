---
// Aviso de cookies. Solo se pinta si hay Google Analytics, Google Tag Manager o píxel de Meta configurados.
// Hasta que la persona pulsa «Aceptar» no se carga ningún script de seguimiento.
interface Props { ga4: string; gtm: string; pixel: string }
const { ga4, gtm, pixel } = Astro.props;
---
<div id="cookies" class="cookies" role="dialog" aria-label="Cookies" hidden>
  <p>Usamos cookies de analítica y publicidad para medir las visitas y mejorar nuestros anuncios. Solo se activan si las aceptas. Más información en la <a href="/privacidad">política de privacidad</a>.</p>
  <div class="acciones">
    <button type="button" class="boton" data-cookies="si">Aceptar</button>
    <button type="button" class="boton" data-cookies="no">Rechazar</button>
  </div>
</div>
<script is:inline define:vars={{ ga4, gtm, pixel }}>
  (function () {
    var caja = document.getElementById('cookies');
    var cargado = false;
    function leerCookie(nombre) {
      var m = document.cookie.match(new RegExp('(?:^|; )' + nombre + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : '';
    }
    function nuevoId() {
      return (window.crypto && window.crypto.randomUUID)
        ? window.crypto.randomUUID()
        : 'ev-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);
    }
    function enviarMeta(evento, datos) {
      if (!pixel || !cargado) return;
      var eventId = nuevoId();
      if (typeof window.fbq === 'function') window.fbq('track', evento, datos || {}, { eventID: eventId });
      try {
        var cuerpo = JSON.stringify({
          pixel_id: pixel,
          event_name: evento,
          event_id: eventId,
          event_source_url: location.href,
          fbp: leerCookie('_fbp'),
          fbc: leerCookie('_fbc'),
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/.netlify/functions/meta-capi', new Blob([cuerpo], { type: 'application/json' }));
        } else {
          fetch('/.netlify/functions/meta-capi', { method: 'POST', headers: { 'content-type': 'application/json' }, body: cuerpo, keepalive: true }).catch(function () {});
        }
      } catch (e) {}
    }
    window.__metaTrack = function (evento, datos) {
      if (!pixel) return;
      if (cargado) enviarMeta(evento, datos);
      else (window.__metaCola = window.__metaCola || []).push([evento, datos]);
    };
    function cargar() {
      if (cargado) return;
      cargado = true;
      if (ga4) {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', ga4);
      }
      if (gtm) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var tg = document.createElement('script');
        tg.async = true;
        tg.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtm;
        document.head.appendChild(tg);
      }
      if (pixel) {
        !function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
          if (!f._fbq) f._fbq = n;
          n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
          t = b.createElement(e); t.async = true; t.src = v;
          s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
        }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', pixel);
        enviarMeta('PageView');
        if (Array.isArray(window.__metaCola)) {
          window.__metaCola.forEach(function (item) { enviarMeta(item[0], item[1]); });
          window.__metaCola = [];
        }
      }
    }
    function guardada() { try { return localStorage.getItem('cookies'); } catch (e) { return null; } }
    function guardar(v) { try { localStorage.setItem('cookies', v); } catch (e) {} }
    caja.addEventListener('click', function (ev) {
      var v = ev.target && ev.target.getAttribute && ev.target.getAttribute('data-cookies');
      if (!v) return;
      guardar(v);
      caja.hidden = true;
      if (v === 'si') cargar();
      else if (cargado) location.reload();
    });
    // Enlace del pie para cambiar la decisión
    window.abrirCookies = function () { caja.hidden = false; };
    var g = guardada();
    if (g === 'si') cargar();
    else if (g !== 'no') caja.hidden = false;
  })();
</script>
