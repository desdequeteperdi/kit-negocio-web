---
// Datos estructurados (JSON-LD) de una entrada: BlogPosting, BreadcrumbList y, si hay, FAQPage.
// Las preguntas son las mismas que se muestran en la página (Google lo exige).
import { getContenido, type Entrada } from '../lib/contenido';
interface Props { entrada: Entrada }
const { entrada: e } = Astro.props;
const c = await getContenido();
const n = c.negocio;
const abs = (ruta: string) => new URL(ruta, Astro.site).href;
const url = abs(`/blog/${e.slug}`);
const autor = e.autor || n.nombre;
const grafo: Record<string, unknown>[] = [
  {
    '@type': 'BlogPosting',
    headline: e.titulo,
    description: e.seoDescripcion || e.resumen,
    ...(e.imagen && !e.imagen.endsWith('.svg') && { image: abs(e.imagen) }),
    datePublished: e.fecha,
    dateModified: e.actualizada || e.fecha,
    author: { '@type': e.autor ? 'Person' : 'Organization', name: autor },
    publisher: { '@type': 'Organization', name: n.nombre, url: abs('/') },
    mainEntityOfPage: url,
    ...(e.etiquetas.length && { keywords: e.etiquetas.join(', ') }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: c.blog.titulo, item: abs('/blog') },
      { '@type': 'ListItem', position: 3, name: e.titulo, item: url },
    ],
  },
];
if (e.faqs.length) {
  grafo.push({
    '@type': 'FAQPage',
    mainEntity: e.faqs.map((f) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta } })),
  });
}
// "<" escapado para que ningún texto del panel pueda cerrar la etiqueta script
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo }).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json}></script>
