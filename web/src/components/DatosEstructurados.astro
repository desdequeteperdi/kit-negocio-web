---
// Datos estructurados (JSON-LD) para que Google entienda qué es el negocio y dónde actúa.
// No se publica la dirección fiscal: solo la zona de servicio y los datos de contacto del panel.
import { getContenido } from '../lib/contenido';
const c = await getContenido();
const n = c.negocio;
const datos = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: n.nombre,
  description: n.descripcion,
  url: new URL('/', Astro.site).href,
  ...(n.telefono && { telephone: n.telefono }),
  ...(n.email && { email: n.email }),
  ...(n.zona && { areaServed: n.zona }),
};
// "<" escapado para que ningún texto del panel pueda cerrar la etiqueta script
const json = JSON.stringify(datos).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json}></script>
